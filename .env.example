# Data locations (defaults assume docker-compose mounts ./data)
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Reference date. Leave empty to use the system date.
APP_TODAY=2026-10-19

# LLM provider: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# auto = use GPU if available else CPU. Force with cpu | cuda. (Docker image is CPU-only.)
EMBEDDING_DEVICE=auto
# auto = reranker on with a GPU, off on CPU. Force with true | false.
RERANK_ENABLED=auto
RERANK_MODEL=BAAI/bge-reranker-base
CORPUS_TOKEN_BUDGET=3000
